# Настройки веб-приложения. Скопируйте в .env и заполните. Файл .env в git не попадает.

# dev, test или prod. В prod без CAPPER_SECRET_KEY и CAPPER_MASTER_KEYS приложение не стартует
CAPPER_ENV=dev
# Уровень логов: DEBUG, INFO, WARNING
CAPPER_LOG_LEVEL=INFO

# PostgreSQL и Redis. В docker compose хосты — имена сервисов: postgres, redis
CAPPER_DATABASE_URL=postgresql+asyncpg://capper:capper@localhost:5432/capper
CAPPER_REDIS_URL=redis://localhost:6379/0
# Префикс всех ключей Redis приложения
CAPPER_REDIS_PREFIX=capper:

# Секрет для HMAC-хешей кодов приглашений, сброса и резервных кодов. В prod обязателен,
# не короче 32 символов. Смена секрета делает недействительными все выданные коды:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CAPPER_SECRET_KEY=

# Мастер-ключи AES-256-GCM для секретов в базе (2FA, ключи Claude): "версия:base64(32 байта)"
# через запятую, последний — текущий. Старые ключи не удалять, пока есть записи с их версией.
# В dev и test без значения используется ключ для разработки. Новый ключ:
#   python -c "import base64, os; print('1:' + base64.b64encode(os.urandom(32)).decode())"
# Смена ключа: дописать "...,2:<новый>" в конец строки.
CAPPER_MASTER_KEYS=

# Адрес сайта, как его видит браузер (с ним сверяется заголовок Origin).
# dev: адрес Vite; prod: https://<домен>
CAPPER_PUBLIC_ORIGIN=http://localhost:5173
# Cookie с флагом Secure и префиксом __Host-. Без значения: true в prod, false в dev и test
# CAPPER_COOKIE_SECURE=
# Проверка новых паролей по базе утечек Have I Been Pwned. Без значения: true в prod
# CAPPER_HIBP_ENABLED=

# Адреса или сети прокси (Caddy) через запятую. Только от них приложение берет IP клиента
# из X-Forwarded-For. Если Caddy в отдельном контейнере, впишите его адрес или сеть
# docker, например 172.18.0.0/16. Без этого у всех клиентов будет адрес Caddy, и лимит
# попыток входа закроет вход всем. "*" не ставить: тогда IP подделает любой клиент.
CAPPER_TRUSTED_PROXIES=127.0.0.1

# Сроки входа (значения по умолчанию из PLAN.md, раздел 7)
# CAPPER_SESSION_IDLE_DAYS=14
# CAPPER_SESSION_ABSOLUTE_DAYS=30
# CAPPER_TRUSTED_DEVICE_DAYS=30
# CAPPER_LOGIN_PENDING_MINUTES=5
# CAPPER_INVITE_DAYS=7
# CAPPER_RESET_CODE_HOURS=24
# Сколько хешей пароля (Argon2, 64 МиБ каждый) считается одновременно; обычно число vCPU
# CAPPER_PASSWORD_HASH_SLOTS=2

# Загрузка архивов матчей и кэфов (этап 2). Без значения — адреса и годы ниже.
# Архив Jeff Sackmann, основной тур ATP с 2000 года. Сам Сакманн убрал tennis_atp с GitHub
# в сентябре 2026; по умолчанию — архивная копия (снимок июня 2026, та же лицензия)
# CAPPER_SACKMANN_BASE_URL=https://raw.githubusercontent.com/Aneeshers/tennis-sackmann-archive/main/atp
# CAPPER_DATA_FIRST_YEAR=2000
# Кэфы и даты матчей tennis-data.co.uk, файлы .xlsx с 2013 года (раньше 2013 не бывает)
# CAPPER_TENNIS_DATA_BASE_URL=http://www.tennis-data.co.uk
# CAPPER_TENNIS_DATA_FIRST_YEAR=2013
# Час ночного обновления данных воркером, UTC (0–23); запуск в 25 минут этого часа
# CAPPER_DATA_UPDATE_HOUR_UTC=5
# Расписание воркера (очистка, ночное обновление, уборщик анализов); false — только задачи
# из очереди (так работает стек сквозных тестов scripts/e2e-stack.sh)
# CAPPER_WORKER_CRON=true

# Push-уведомления браузера (этап 6, Web Push): ключи VAPID. Без них приложение работает,
# push выключен. Все три строки печатает команда (на сервере — с вашим email):
#   python -m app.admin.cli generate-vapid --subject mailto:you@example.com
# Закрытый ключ — секрет: в git и в логи не попадает. Смена ключей отключает push на всех
# устройствах (его включают заново в «Личный кабинет → Уведомления»). На телефоне push
# работает только на сайте с HTTPS
# CAPPER_VAPID_PUBLIC_KEY=
# CAPPER_VAPID_PRIVATE_KEY=
# CAPPER_VAPID_SUBJECT=mailto:you@example.com
# Подписки push по http и на любом сервере — только localhost и стек сквозных тестов
# (поддельный сервис push). В prod запрещено
# CAPPER_PUSH_ALLOW_HTTP=false

# Только для тестов: служебная база, из которой тесты создают свою временную базу
# CAPPER_TEST_ADMIN_DATABASE_URL=postgresql://capper:capper@localhost:5432/postgres

# Ключ Claude API здесь не указывается: администратор вводит его в кабинете
# или командой set-admin-key, ключ хранится в базе в зашифрованном виде (PLAN.md, решение Р7).
# Адрес Claude API. Только для локальных прогонов без ключа — поддельный сервер
# backend/tests/fake_claude.py; в prod — только https
# CAPPER_ANTHROPIC_BASE_URL=https://api.anthropic.com
