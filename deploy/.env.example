# Настройки сервера для docker compose. Скопируйте в deploy/.env (в git не попадает),
# заполните и закройте от чужих глаз: chmod 600 deploy/.env.
# server-setup.sh создает deploy/.env сам и заполняет пароли и ключи случайными значениями.
# Корневой .env.example — для разработки на своем компьютере, здесь — только для сервера.

# --- Сайт ---

# Домен сайта без https://. DNS-запись A должна указывать на сервер: по ней Caddy
# получает сертификат Let's Encrypt. localhost — проверка на своей машине с локальным
# сертификатом Caddy (curl -k https://localhost/api/health)
CAPPER_DOMAIN=capper.example.com

# --- Пароли и ключи (только латиница и цифры: пароль базы входит в адрес подключения) ---

# Пароль PostgreSQL. Новый: openssl rand -hex 24
POSTGRES_PASSWORD=
# Секрет для HMAC-хешей кодов приглашений, сброса и резервных кодов, не короче 32 символов.
# Смена делает недействительными все выданные коды. Новый: openssl rand -hex 32
CAPPER_SECRET_KEY=
# Мастер-ключи AES-256-GCM для секретов в базе (2FA, ключи Claude): "версия:base64(32 байта)"
# через запятую, последний — текущий. Новый: echo "1:$(openssl rand -base64 32)"
# Смена ключа: дописать ",2:<новый>" в конец. Старые не удалять: без них зашифрованное
# в базе не прочитать. Храните копию строки вне сервера (менеджер паролей): копия базы
# без мастер-ключей не расшифрует 2FA и ключи Claude
CAPPER_MASTER_KEYS=

# --- Бэкапы (deploy/backup) ---

# Публичные ключи age, которыми шифруются копии, через запятую. Рекомендуется два:
# личный ключ владельца (секретная часть только у вас, в менеджере паролей) и ключ
# сервера для ежемесячной проверки восстановления. Пара ключей:
#   docker compose run --rm --no-deps backup age-keygen
# Без значения ночной бэкап не создается (незашифрованные копии не пишутся)
BACKUP_AGE_RECIPIENTS=
# Секретный ключ age сервера (строка AGE-SECRET-KEY-1...): нужен restore-check.sh и
# restore.sh. Без него копии делаются, но проверка восстановления не проходит
BACKUP_AGE_IDENTITY=

# Папка с копиями на сервере (относительно deploy/ или абсолютный путь)
# BACKUP_LOCAL_DIR=./backup/dumps
# Сколько копий хранить (PLAN.md, раздел 5)
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# Копии перед деплоем и восстановлением
# BACKUP_KEEP_MANUAL=5

# S3-совместимое хранилище в ЕС (Р19), например Hetzner Object Storage в Хельсинки.
# Без этих значений копии лежат только на сервере (в логе бэкапа будет предупреждение).
# Ключу доступа достаточно прав на чтение и запись в один бакет
BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_REGION=hel1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Папка внутри бакета
# BACKUP_S3_PREFIX=capper
# Провайдер для rclone: Other подходит любому S3-совместимому хранилищу
# BACKUP_S3_PROVIDER=Other

# --- Данные о матчах (этап 2) ---

# Час ночного обновления архивов воркером, UTC (0–23); запуск в 25 минут этого часа
# CAPPER_DATA_UPDATE_HOUR_UTC=5
# Архив Jeff Sackmann и первый год, основной тур ATP. Сам Сакманн убрал tennis_atp с GitHub
# в сентябре 2026; по умолчанию — архивная копия (снимок июня 2026, та же лицензия)
# CAPPER_SACKMANN_BASE_URL=https://raw.githubusercontent.com/Aneeshers/tennis-sackmann-archive/main/atp
# CAPPER_DATA_FIRST_YEAR=2000
# Кэфы и дни матчей tennis-data.co.uk, файлы .xlsx с 2013 года (раньше 2013 не бывает)
# CAPPER_TENNIS_DATA_BASE_URL=http://www.tennis-data.co.uk
# CAPPER_TENNIS_DATA_FIRST_YEAR=2013

# --- Прочее ---

# Уровень логов: DEBUG, INFO, WARNING
# CAPPER_LOG_LEVEL=INFO
# Подсети docker для Caddy и API. Менять, только если они пересекаются с другой сетью
# на сервере: тогда docker compose up сообщит "Pool overlaps with other one"
# CAPPER_EDGE_SUBNET=10.203.0.0/24
# CAPPER_EDGE_SUBNET6=fd00:ca9e:203::/64
# IPv6 в сети Caddy: с ним посетители по IPv6 (запись AAAA) приходят в API со своими
# адресами. false — только если в ядре нет IPv6 (docker compose up сообщит
# "Cannot read IPv6 setup"); тогда запись AAAA не заводить
# CAPPER_EDGE_IPV6=true
# Лимиты контейнера api: память и доли процессора. По умолчанию 1g и 1.5 — для сервера
# на 2 vCPU и 4 ГБ, где рядом PostgreSQL, Redis, воркер и Caddy. На сервере с 1 vCPU
# deploy.sh сам ставит CAPPER_API_CPUS=1, если здесь лимит не задан
# CAPPER_API_MEM_LIMIT=1g
# CAPPER_API_CPUS=1.5
